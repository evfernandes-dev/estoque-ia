# Endereço do Ollama local. No Docker Compose o padrão é host.docker.internal.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

# Banco fictício gerado por python -m estoque_ia.seed --force
ESTOQUE_DB_PATH=data/estoque.db

# Limite de idas e voltas entre agente e modelo.
MAX_ITERACOES=5

# Opcional. Se preencher, a API exige o cabeçalho X-API-Token.
API_TOKEN=
